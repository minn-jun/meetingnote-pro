# 복사해서 .env 로 쓴다. .env 는 git 에 올리지 않는다

# JWT 서명 키 (긴 임의 문자열)
JWT_SECRET=change-me

# Gemini 받아쓰기 · 3항목 구분 (docs/결정사항.md D2). 키는 Google AI Studio 에서 발급
STT_API_KEY=
STT_MODEL=gemini-3.8-flash
SUMMARY_MODEL=gemini-3.8-flash

# 비우면 로컬 SQLite (meetingnote.db). 배포는 Neon 연결 문자열
DATABASE_URL=

# 업로드 상한 MB. 로컬 25, Vercel 배포 4 (D3)
MAX_UPLOAD_MB=25

# 허용 출처. 쉼표로 구분
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Swagger UI (/docs). false 면 끈다
DOCS_ENABLED=true
